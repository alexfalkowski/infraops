{
  version: "2.0"
  applications: [
    {
      name: app1
      version: 1.1.0
      replicas: 3
      strategy: recreate
    }
    {
      name: app2
      version: 1.0.0
      replicas: 3
      strategy: rolling
      storage: {
        data: {
          capacity: 1Gi
          path: /data
        }
        archive: {
          capacity: 2Gi
          path: /staging
        }
      }
    }
  ]
}
