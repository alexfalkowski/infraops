#!/usr/bin/env bash
set -eo pipefail

# Scans app manifests or live namespaces with shared deployment lint settings.
# Kubescape 4.0.17's default scan cannot load workloadscan from its cache fallback.
KS_SKIP_UPDATE_CHECK=true kubescape scan framework allcontrols --verbose --scan-images=false --host-scan=false "$@"
